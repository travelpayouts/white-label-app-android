<?xml version="1.0" encoding="utf-8"?>
<!--
    Kept for compatibility only. The SDK used to declare a Google Maps API key
    in its manifest, for map screens that no longer exist, and every app built
    on this template had to define this string. SDK versions after 1.7.2 no
    longer reference it, and the configuration no longer asks for it.

    If you build against an SDK newer than 1.7.2, this file can be deleted.
    Keep it while you still build against 1.7.2 or older: their manifest
    references this string, and the build fails without it.
-->
<resources>
    <string name="google_maps_api_key" translatable="false"></string>
</resources>
