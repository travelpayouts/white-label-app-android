  <string name="ta_info_visa_title">Transit dengan visa di %s</string>
  <string name="ta_info_visa_subtitle">Sejumlah bandara tidak memiliki zona transit, ini berarti jika ada layover maka Anda akan memasuki negara tersebut dan Anda akan memerlukan visa.</string>
  <string name="ta_recheck_baggage_title">Pemesanan interline</string>
  <string name="ta_recheck_baggage_subtitle">Ini bukanlah satu tiket, melainkan beberapa tiket berbeda dalam satu pemesanan, atau disebut juga pemesanan interline. Tiket seperti ini sering kali lebih murah dari pemesanan biasa, tetapi ada beberapa hal yang perlu dipertimbangkan:</string>
  <string name="ta_recheck_baggage_subtitle1">Anda harus melapor masuk untuk penerbangan lanjutan pada layover, termasuk mengambil dan mendaftarkan ulang bagasi</string>
  <string name="ta_recheck_baggage_subtitle2">Layover akan mengharuskan Anda memasuki negara—jika Anda memerlukan visa, Anda akan dimintai itu saat pemeriksaan paspor</string>
  <string name="ta_recheck_baggage_subtitle3">Jika negara layover sedang tidak mengizinkan turis masuk, Anda mungkin tidak dapat mengikuti penerbangan lanjutan Anda</string>
  <string name="ta_recheck_baggage_subtitle4">Jika Anda melewatkan penerbangan lanjutan Anda karena penerbangan pertama tertunda, pihak maskapai tidak akan memberi kompensasi atas pengeluaran Anda</string>
  <string name="ta_recheck_baggage_subtitle_5">Persyaratan pengembalian dana dan penukaran kemungkinan besar berbeda untuk masing-masing tiket</string>
  <string name="ta_recheck_baggage_last_paragraph">Anda mungkin sebaiknya menghindari tiket seperti ini jika Anda bukan merupakan pelancong berpengalaman</string>
  <string name="ta_info_night_transfer_title">Singgah bermalam di %s</string>
  <string name="ta_info_night_transfer_subtitle">Anda harus mengeluarkan uang untuk hotel atau tidur di bangku taman. Harap diingat bahwa sebagian bandara tutup pada malam hari.</string>
  <string name="ta_info_fast_transfer_title">Singgah singkat di %s</string>
  <string name="ta_info_fast_transfer_subtitle">Hanya %s — Anda harus bergegas:</string>
  <string name="ta_info_fast_transfer_subtitle1">Jika Anda bepergian dengan bagasi, Anda harus mengambilnya dan mendaftarkannya kembali</string>
  <string name="ta_info_fast_transfer_subtitle2">Antrean tak terduga di kontrol perbatasan</string>
  <string name="ta_info_fast_transfer_subtitle3">Terkadang terminal dapat terletak jauh dari satu sama lain</string>
  <string name="ta_info_fast_transfer_subtitle4">Anda mungkin tidak punya cukup waktu mengejar penerbangan lanjutan jika penerbangan Anda sebelumnya tertunda</string>
  <string name="ta_info_airport_change_title">Transit dengan pindah bandara di %s</string>
  <string name="ta_info_airport_change_subtitle">Ini tidak sulit, tetapi ada beberapa hal yang perlu dipertimbangkan:</string>
  <string name="ta_info_airport_change_subtitle1">Anda harus membayar transportasi antarbandara</string>
  <string name="ta_info_airport_change_subtitle2">Anda harus mengambil dan mendaftarkan ulang bagasi Anda</string>
  <string name="ta_info_airport_change_subtitle3">Ada risiko terjebak macet hingga Anda melewatkan penerbangan Anda</string>
