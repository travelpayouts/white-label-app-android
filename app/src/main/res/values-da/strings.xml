  <string name="ta_info_visa_title">Ophold med visum i %s</string>
  <string name="ta_info_visa_subtitle">Nogle lufthavne har ikke en transitzone, hvilket betyder, at overnatninger mellem fly kræver, at du indrejser i landet og derfor skal have et visum.</string>
  <string name="ta_recheck_baggage_title">Interline-booking</string>
  <string name="ta_recheck_baggage_subtitle">Det er ikke én billet, men flere forskellige billetter i én booking - bedre kendt som en interline-booking. De er ofte billigere end almindelige bookinger, men der er et par ting, du bør tænke over:</string>
  <string name="ta_recheck_baggage_subtitle1">Du skal tjekke ind til din forbindende flyvning til overnatningen mellem fly, herunder indhentning og indtjekning af eventuel bagage</string>
  <string name="ta_recheck_baggage_subtitle2">Overnatningen mellem fly indebærer, at du skal rejse ind i landet - hvis et visum er påkrævet, skal du kunne fremvise det ved paskontrollen</string>
  <string name="ta_recheck_baggage_subtitle3">Hvis landet for overnatningen mellem fly ikke tillader turister i øjeblikket, vil du muligvis ikke komme med dit forbindende fly</string>
  <string name="ta_recheck_baggage_subtitle4">Hvis du ikke når dit forbindende fly, fordi dit første er forsinket, kompenserer flyselskabet dig ikke for dine udgifter</string>
  <string name="ta_recheck_baggage_subtitle_5">Vilkårene for refunderinger og udvekslinger vil sandsynligvis være forskellige for hver billet</string>
  <string name="ta_recheck_baggage_last_paragraph">Du bør nok undgå disse billetter, hvis du ikke er erfaren i at rejse</string>
  <string name="ta_info_night_transfer_title">Ophold over natten på %s</string>
  <string name="ta_info_night_transfer_subtitle">Du skal bruge penge på et hotel eller sove på en parkbænk. Bemærk, at nogle lufthavne er lukket om natten.</string>
  <string name="ta_info_fast_transfer_title">Kort ventetid i %s</string>
  <string name="ta_info_fast_transfer_subtitle">Kun %s – du skal skynde dig:</string>
  <string name="ta_info_fast_transfer_subtitle1">Hvis du rejser med bagage, skal du hente den og tjekke den ind igen</string>
  <string name="ta_info_fast_transfer_subtitle2">Uforudsigelige køer ved grænsekontrollen</string>
  <string name="ta_info_fast_transfer_subtitle3">Nogle gange kan terminaler være placeret langt fra hinanden</string>
  <string name="ta_info_fast_transfer_subtitle4">Du når muligvis ikke dit forbindende fly, hvis det tidligere bliver forsinket</string>
  <string name="ta_info_airport_change_title">Ophold med lufthavnsskift i %s</string>
  <string name="ta_info_airport_change_subtitle">Det er ikke svært, men der er nogle ting, du bør være opmærksom på:</string>
