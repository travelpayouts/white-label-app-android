  <string name="ta_info_visa_title">Quá cảnh với visa ở %s</string>
  <string name="ta_info_visa_subtitle">Một số sân bay không có khu vực quá cảnh, nghĩa là trong thời gian quá cảnh, bạn phải nhập cảnh vào quốc gia đó và sẽ cần có visa.</string>
  <string name="ta_recheck_baggage_title">Đặt chỗ chuyến bay liên danh</string>
  <string name="ta_recheck_baggage_subtitle">Đây không phải một vé mà một số vé khác nhau trong cùng một yêu cầu đặt chỗ, hay còn gọi là đặt chỗ liên tuyến. Hình thức này thường rẻ hơn các hình thức đặt chỗ thông thường. Tuy nhiên, bạn cần lưu ý những điều sau:</string>
  <string name="ta_recheck_baggage_subtitle1">Bạn phải làm thủ tục lên chuyến bay nối chuyến trong thời gian quá cảnh, bao gồm cả việc tự đi lấy rồi ký gửi tiếp hành lý lên chuyến bay tiếp theo</string>
  <string name="ta_recheck_baggage_subtitle2">Bạn sẽ phải nhập cảnh vào quốc gia đó trong thời gian quá cảnh. Nếu bạn cần có visa, bên kiểm soát hộ chiếu sẽ yêu cầu bạn xuất trình</string>
  <string name="ta_recheck_baggage_subtitle3">Nếu quốc gia mà bạn quá cảnh hiện không cho phép khách du lịch, bạn có thể sẽ không thực hiện được chuyến bay nối chuyến</string>
  <string name="ta_recheck_baggage_subtitle4">Nếu bạn lỡ chuyến bay nối chuyện do chuyến bay đầu tiên của bạn bị trễ thì hãng hàng không sẽ không bồi thường các chi phí bạn đã bỏ ra</string>
  <string name="ta_recheck_baggage_subtitle_5">Các điều khoản hoàn tiền và chuyển đổi rất có thể khác nhau tùy theo từng vé</string>
