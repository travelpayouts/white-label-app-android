  <string name="ta_info_visa_title">Persinggahan dengan visa di %s</string>
  <string name="ta_info_visa_subtitle">Beberapa lapangan terbang tidak mempunyai zon transit, bermakna hentian akan melibatkan anda memasuki negara tersebut dan memerlukan visa.</string>
  <string name="ta_recheck_baggage_title">Tempahan antara talian</string>
  <string name="ta_recheck_baggage_subtitle">Ia bukannya satu tiket, namun beberapa tiket berbeza dalam satu tempahan, atau dipanggil sebagai tempahan antara laluan. Ia selalunya lebih murah daripada tempahan biasa, namun terdapat beberapa perkara untuk dipertimbangkan:</string>
  <string name="ta_recheck_baggage_subtitle1">Anda perlu mendaftar masuk untuk penerbangan sambungan di hentian tersebut, termasuk memungut dan menyemak semula sebarang bagasi</string>
  <string name="ta_recheck_baggage_subtitle2">Hentian akan melibatkan anda memasuki negara tersebut - sekiranya anda memerlukan visa, anda akan ditanya di kawalan pasport</string>
  <string name="ta_recheck_baggage_subtitle3">Sekiranya negara hentian tersebut tidak membenarkan kemasukan pelancong buat masa ini, anda mungkin tidak dapat menaiki penerbangan sambungan anda</string>
  <string name="ta_recheck_baggage_subtitle4">Sekiranya anda terlepas penerbangan sambungan anda disebabkan oleh kelewatan penerbangan awal, syarikat penerbangan tidak akan memberikan pampasan terhadap perbelanjaan anda</string>
  <string name="ta_recheck_baggage_subtitle_5">Terma untuk bayaran balik dan penukaran selalunya berbeza untuk setiap tiket</string>
  <string name="ta_recheck_baggage_last_paragraph">Mungkin anda perlu mengelakkan tiket-tiket sebegini jika anda bukannya seorang pelancong yang berpengalaman</string>
  <string name="ta_info_night_transfer_title">Berhenti bermalam sebentar di %s</string>
  <string name="ta_info_night_transfer_subtitle">Anda perlu membelanjakan wang bagi hotel atau tidur di kerusi taman. Sila ambil perhatian bahawa terdapat lapangan terbang yang ditutup pada waktu malam.</string>
  <string name="ta_info_fast_transfer_title">Singgah sebentar di %s</string>
  <string name="ta_info_fast_transfer_subtitle">Cuma %s – anda perlu cepat:</string>
  <string name="ta_info_fast_transfer_subtitle1">Sekiranya anda melancong menggunakan bagasi, anda perlu memungutnya dan menyemak masuk semula</string>
  <string name="ta_info_fast_transfer_subtitle2">Barisan tidak dapat dijangkan di kawalan sempadan</string>
  <string name="ta_info_fast_transfer_subtitle3">Kadangkala terminal mungkin berada di lokasi yang jauh antara satu sama lain</string>
  <string name="ta_info_fast_transfer_subtitle4">Anda mungkin lewat untuk penerbangan sambungan anda sekiranya penerbangan awal ditangguh</string>
  <string name="ta_info_airport_change_title">Persinggahan dengan pertukaran lapangan terbang di %s</string>
  <string name="ta_info_airport_change_subtitle">Ianya bukanlah sukar, namun terdapat beberapa perkara untuk dipertimbangkan:</string>
  <string name="ta_info_airport_change_subtitle1">Anda perlu membayar pengangkutan antara lapangan terbang</string>
  <string name="ta_info_airport_change_subtitle2">Anda telah memungut dan menyemak semula bagasi anda</string>
  <string name="ta_info_airport_change_subtitle3">Terdapat risiko untuk menghadapi kesesakan lalu lintas dan terlepas penerbangan anda</string>
