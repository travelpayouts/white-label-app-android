  <string name="ta_info_visa_title">Mellomlanding med visum i %s</string>
  <string name="ta_info_visa_subtitle">Noen flyplasser har ingen transitt-sone, noe som betyr at mellomlanding innebærer at du må reise inn i landet og trenger visum.</string>
  <string name="ta_recheck_baggage_title">Interline booking</string>
  <string name="ta_recheck_baggage_subtitle">Det er ikke én billett, men flere ulike billetter i én bestilling, en såkalt interline-billett. De er ofte billigere enn vanlige bestillinger, men det er noen ting du må tenke på:</string>
  <string name="ta_recheck_baggage_subtitle1">Du må sjekke inn til mellomlandingen, og du må hente og sjekke inn eventuell bagasje på nytt</string>
  <string name="ta_recheck_baggage_subtitle2">Mellomlandingen innebærer at du må reise inn i landet - hvis du trenger visum, vil du bli bedt om det i passkontrollen</string>
  <string name="ta_recheck_baggage_subtitle3">Hvis mellomlandingslandet ikke tillater turister for øyeblikket, kan det hende at du ikke rekker videreflyet ditt</string>
  <string name="ta_recheck_baggage_subtitle4">Hvis du ikke rekker forbindelsesflyet på grunn av at det første flyet er forsinket, vil flyselskapet ikke kompensere for utgiftene dine</string>
  <string name="ta_recheck_baggage_subtitle_5">Vilkårene for refusjon og bytte vil sannsynligvis være forskjellige for hver enkelt billett</string>
  <string name="ta_recheck_baggage_last_paragraph">Du bør sannsynligvis unngå disse billettene hvis du ikke er en erfaren reisende</string>
  <string name="ta_info_night_transfer_title">Mellomlanding med overnatting i %s</string>
  <string name="ta_info_night_transfer_subtitle">Du må bruke penger på hotell eller sove på en parkbenk. Husk at noen flyplasser er stengt om natten.</string>
  <string name="ta_info_fast_transfer_title">Kort mellomlanding i %s</string>
  <string name="ta_info_fast_transfer_subtitle">Bare %s, du må skyndte deg:</string>
  <string name="ta_info_fast_transfer_subtitle1">Hvis du reiser med bagasje, må du hente den ut og sjekke den inn igjen</string>
  <string name="ta_info_fast_transfer_subtitle2">Uforutsigbare køer ved grensekontrollen</string>
  <string name="ta_info_fast_transfer_subtitle3">Noen ganger kan terminalene ligge langt fra hverandre</string>
  <string name="ta_info_fast_transfer_subtitle4">Det er ikke sikkert at du rekker videreflyet ditt hvis det forrige flyet blir forsinket</string>
