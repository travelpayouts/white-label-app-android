  <string name="ta_info_visa_title">Välilasku viisumilla kohteessa %s</string>
  <string name="ta_info_visa_subtitle">Kaikilla lentoasemilla ei ole kauttakulkualuetta, minkä vuoksi välilaskut tarkoittavat kyseisen valtion alueelle menemistä, mikä voi vaatia viisumin.</string>
  <string name="ta_recheck_baggage_title">Interline-varaus</string>
  <string name="ta_recheck_baggage_subtitle">Kyseessä ei ole yksittäinen lippu, vaan useita erillisiä lippuja yhdessä varauksessa, joka tunnetaan myös interline-varauksena. Ne ovat usein tavallisia varauksia edullisempia, mutta niiden tapauksessa on syytä ottaa erinäisiä asioita huomioon:</string>
  <string name="ta_recheck_baggage_subtitle1">Sinun on ilmoittauduttava jatkolennollesi välilaskun aikana, mikä vaatii myös matkatavaroiden noutamisen ja tarkastuksen</string>
  <string name="ta_recheck_baggage_subtitle2">Välilasku tarkoittaa kyseiseen valtioon menemistä, mikä saattaa vaatia viisumin kysymistä passintarkastuksen yhteydessä</string>
  <string name="ta_recheck_baggage_subtitle3">Jos välilaskumaa ei ota sillä hetkellä vastaan turisteja, niin et välttämättä ehdi jatkolennollesi</string>
  <string name="ta_recheck_baggage_subtitle4">Lentoyhtiö ei korvaa kulujasi, jos et ehdi jatkolennollesi ensimmäisen lentosi viivästymisen vuoksi</string>
  <string name="ta_recheck_baggage_subtitle_5">Korvausten ja vaihtojen ehdot todennäköisesti vaihtelevat lipusta riippuen</string>
  <string name="ta_recheck_baggage_last_paragraph">Näitä lippuja ei välttämättä kannata hankkia, jos et ole kokenut matkaaja</string>
  <string name="ta_info_night_transfer_title">Yön yli kestävä välilasku kohteessa %s</string>
  <string name="ta_info_night_transfer_subtitle">Voit joutua maksamaan hotellissa yöpymisestä tai nukkumaan puistonpenkillä. Otathan huomioon, että jotkin lentoasemat suljetaan yöksi.</string>
  <string name="ta_info_fast_transfer_title">Lyhyt välilasku kohteessa %s</string>
  <string name="ta_info_fast_transfer_subtitle">Vain %s – sinun on pidettävä kiirettä:</string>
  <string name="ta_info_fast_transfer_subtitle1">Jos matkustat matkatavaroiden kanssa, ne tulee kerätä ja kirjata uudelleen</string>
  <string name="ta_info_fast_transfer_subtitle2">Ennalta arvaamattomat jonot rajavalvonnassa</string>
  <string name="ta_info_fast_transfer_subtitle3">Toisinaan terminaalit voivat olla kaukana toisistaan</string>
  <string name="ta_info_fast_transfer_subtitle4">Et välttämättä ehdi ajoissa jatkolennollesi, jos aikaisempi lentosi viivästyy</string>
  <string name="ta_info_airport_change_title">Välilasku lentoaseman vaihdolla kohteessa %s</string>
  <string name="ta_info_airport_change_subtitle">Se ei ole vaikeaa, mutta erinäisiä seikkoja kannattaa ottaa huomioon:</string>
